{
  "name": "dsh-turn-notify",
  "version": "1.0.1",
  "description": "Desktop and browser notifications for DSH: get notified when a turn finishes or the agent waits for your confirmation.",
  "type": "module",
  "license": "MIT",
  "author": "Ly007-dotcom",
  "homepage": "https://github.com/Ly007-dotcom/dsh-turn-notify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ly007-dotcom/dsh-turn-notify.git"
  },
  "bugs": {
    "url": "https://github.com/Ly007-dotcom/dsh-turn-notify/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "notify",
    "desktop",
    "electron",
    "cordis"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.zh-CN.md",
    "MARKET-INDEX.md",
    "CHANGELOG.md",
    "RELEASE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.2-rc.3",
    "fake-indexeddb": "6.2.8"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check client.js && node --check index.js",
    "check:index": "node scripts/check-index.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run check && npm test && npm run check:index && npm run check:package",
    "release:index": "node scripts/prepare-index.mjs"
  },
  "engines": {
    "dsh": "0.2.2-rc.2 || 0.2.2-rc.3"
  }
}
